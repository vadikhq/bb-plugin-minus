+  if (hasAgentContent(row) || visibleRows?.has(apiId(row))) return undefined;
+  const location = runs?.sourceOf.get(apiId(row));
+  const entry = location?.source[location.index];
+  return isServiceReasoning(entry) ? entry : undefined;
+}
