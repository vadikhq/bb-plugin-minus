+          ownerSide === 'left' ? ['pending', 'completed'] : ['completed', 'pending']);
+        assert.deepEqual(markers.map(row => row.querySelector('[data-metrics]').textContent),
+          ownerSide === 'left' ? ['1 tool', '1 tool · 300ms'] : ['1 tool · 300ms', '1 tool']);
